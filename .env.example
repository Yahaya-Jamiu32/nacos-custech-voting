# Placeholders only. Enter the real values in Vercel > Project > Settings > Environment Variables.
SECRET_KEY=type-any-60-random-characters
PHONE_PEPPER=type-another-60-random-characters
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# ADMIN_MATRIC / ADMIN_PHONE are built in (23L1CSS0055 / 07036779507); set these only to override.
ADMIN_PASSWORD=choose-a-strong-password-12+chars
# Optional instead of ADMIN_PASSWORD: ADMIN_PASSWORD_HASH (from scripts/make_admin_hash.py)
AUTO_INIT_DB=1
